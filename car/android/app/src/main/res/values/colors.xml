<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the indigo/pink defaults that ship inside the capacitor-android
  library with Cassette's own tokens. colorAccent is what tints the media
  notification, which is the surface the car head unit reads.
-->
<resources>
    <color name="colorPrimary">#121114</color>
    <color name="colorPrimaryDark">#0E0D12</color>
    <color name="colorAccent">#E8A24B</color>
</resources>
